{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bawksync",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sync.bawkbawk.net", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bawksync",
      "database_id": "72751245-e301-4b02-904e-986e466f3019",
      "migrations_dir": "migrations"
    }
  ]
}
